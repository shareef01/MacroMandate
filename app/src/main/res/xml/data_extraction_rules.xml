<?xml version="1.0" encoding="utf-8"?>
<!--
    allowBackup is false, so neither transfer path runs today. These rules are
    declared anyway so the exclusion is explicit rather than incidental: the
    DataStore file holds the user's analysis API token in plaintext, and a future
    change that flips allowBackup would otherwise start syncing it to the cloud
    silently.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="evidence" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
